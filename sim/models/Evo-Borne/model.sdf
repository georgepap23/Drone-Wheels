<?xml version="1.0"?>
<sdf version="1.9">
  <model name="evo_borne">
    <link name="chassis">
      <inertial>
        <pose>0.00002 0.00001 -0.01485 0 0 0</pose>
        <mass>0.66830</mass>
        <inertia>
